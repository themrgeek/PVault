{
  "name": "pvault-api",
  "version": "1.0.0",
  "description": "PValult - A secure password vault API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "lint": "eslint src/ api/",
    "format": "prettier --write \"src/**/*.js\" \"api/**/*.js\"",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "password-manager",
    "rest-api",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9"
  }
}